# GoCook Server 配置
# 将本文件复制为 .env 并修改对应值，或通过环境变量设置(cp server/.env.example server/.env)

# 数据库连接（必填）
GOCOOK_DB_CONN_STRING=dbname=gocookdb user=gocook password=gocook123 host=127.0.0.1 port=5432

# JWT 签名密钥（必填，生产环境请使用随机生成的 >= 32 字符密钥）
GOCOOK_JWT_SECRET=GoCook-Project-Secret-Key-Change-Me-In-Production

# 服务器监听配置
GOCOOK_HOST=0.0.0.0
GOCOOK_PORT=8080

# 数据库连接池大小
GOCOOK_DB_POOL_SIZE=10

# TLS 证书路径（留空则使用 HTTP）
# GOCOOK_TLS_CERT=/path/to/cert.pem
# GOCOOK_TLS_KEY=/path/to/key.pem

# SMTP 邮件发送（用于密码重置等）
# 配置后密码重置令牌会发送到用户邮箱；未配置时 API 响应会返回 dev_token 供调试
# GOCOOK_SMTP_HOST=smtp.gmail.com
# GOCOOK_SMTP_PORT=465          # 465=implicit TLS, 587=STARTTLS
# GOCOOK_SMTP_USER=your-email@gmail.com
# GOCOOK_SMTP_PASS=your-app-password   # Gmail 需使用应用专用密码
# GOCOOK_SMTP_FROM=your-email@gmail.com
# GOCOOK_SMTP_TLS_INSECURE=false       # 开发环境可设为 true 跳过证书验证

# 头像等上传文件存储目录（相对于工作目录，或使用绝对路径）
# 默认：uploads（即 uploads/avatars/）
# GOCOOK_UPLOADS_DIR=uploads

# 日志级别: debug, info, warn, error
GOCOOK_LOG_LEVEL=info
